{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "mingka",
  "main": "brand-worker.js",
  "compatibility_date": "2026-09-08",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // robots.txt와 sitemap.xml을 포함해 모든 요청에서 Worker가 먼저 실행되도록 합니다.
    // Worker가 필요한 경로를 직접 응답한 뒤 나머지는 ASSETS에서 제공합니다.
    "run_worker_first": true
  }
}
